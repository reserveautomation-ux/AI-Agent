{
  "expo": {
    "name": "Workforce OS",
    "slug": "workforce-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workforceos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workforceos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14213D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.workforceos.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#14213D"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FCA311",
          "defaultChannel": "tasks"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Workforce OS uses the microphone so you can speak instructions to your AI workforce.",
          "speechRecognitionPermission": "Workforce OS turns your speech into text so your AI workforce can act on it.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Your AI workforce: one instruction, coordinated agents, verified results."
  }
}
