# Copy to .env (never commit it). EXPO_PUBLIC_* values are built into the app,
# so only put public values here: the Supabase URL and its publishable key are
# safe (RLS protects the data). Never put service-role keys or API keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Where the Workforce API runs. On a real phone this must be reachable from the
# phone: your deployed API (https://...) or your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
