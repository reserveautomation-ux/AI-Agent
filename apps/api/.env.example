# Supabase -> Project Settings -> Database -> Connection string.
# Use the session pooler (port 5432) or transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for projects still on the legacy HS256 JWT secret. Leave unset to verify
# tokens with the project's JWKS signing keys (recommended).
# SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]

# Week 2: the agent workers will need this (not used by the API yet).
# ANTHROPIC_API_KEY=

# Gmail (see docs/DEPLOY.md "Connect Gmail"). TOKEN_ENCRYPTION_KEY must be the same
# on the API and the worker:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# GOOGLE_REDIRECT_URI=https://YOUR-API/connections/google/callback
